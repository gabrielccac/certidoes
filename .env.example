# Copy this file to .env. Docker Compose reads it at container startup;
# these values are not baked into the image.

AIRTABLE_PAT=pat_replace_me
AIRTABLE_BASE_ID=app_replace_me
INGEST_SECRET=replace_with_a_long_random_value
PUBLIC_BASE_URL=https://certidoes.example.com
INGEST_DOMAIN=certidoes.example.com

RECEITA_EXECUTOR=github
RECEITA_GITHUB_REPO=gabrielccac/certidoes
RECEITA_GITHUB_TOKEN=github_pat_replace_me
RECEITA_GITHUB_REF=main

# Visual hCaptcha solver, ported from captcha-solver. Only challenge crops go to OpenRouter.
OPENROUTER_API_KEY=
# RECEITA_CAPTCHA_MODEL=meta/muse-spark-1.3

# Optional: defaults used by the source.
# RECEITA_GITHUB_WORKFLOW=receita-diagnostic.yml
# RECEITA_GITHUB_TIMEOUT_S=900
# RECEITA_GITHUB_POLL_S=5
# RECEITA_GITHUB_PUBLIC_KEY=

# RECEITA_PAYLOAD_PRIVATE_KEY belongs only in the GitHub repository secret.
# Do not copy it into this file or into the Docker container.
