FROM python:3.12-slim-bookworm
ARG CHROME_VERSION=155.0.8059.84

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PYTHONPATH=/app/src \
    HOME=/home/receita DISPLAY=:99 XDG_SESSION_TYPE=x11 \
    CHROME_PATH=/opt/chrome/chrome-linux64/chrome
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
      xvfb xauth x11-utils openbox dbus-x11 poppler-utils ca-certificates \
      fonts-liberation fonts-noto-color-emoji libnss3 libnspr4 libatk1.0-0 \
      libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 libxkbcommon0 \
      libxcomposite1 libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2 \
      libpango-1.0-0 libcairo2 libatspi2.0-0 libxshmfence1 libglib2.0-0 libgtk-3-0 \
    && rm -rf /var/lib/apt/lists/*

RUN python - <<'PY'
from pathlib import Path
import os, urllib.request, zipfile
root = Path('/opt/chrome')
root.mkdir()
archive = root / 'chrome.zip'
chrome_version = os.environ['CHROME_VERSION']
urllib.request.urlretrieve(f'https://storage.googleapis.com/chrome-for-testing-public/{chrome_version}/linux64/chrome-linux64.zip', archive)
with zipfile.ZipFile(archive) as handle:
    handle.extractall(root)
for name in ('chrome', 'chrome_crashpad_handler'):
    (root / 'chrome-linux64' / name).chmod(0o755)
archive.unlink()
PY

RUN pip install --no-cache-dir setuptools requests curl_cffi cryptography \
      seleniumbase==4.56.4 Pillow pypdf==6.21.3
COPY pyproject.toml .
COPY src ./src
COPY config ./config
COPY solved.png .
COPY experiments/receita_actions_probe ./experiments/receita_actions_probe
COPY experiments/receita_environment_probe ./experiments/receita_environment_probe
RUN pip install --no-cache-dir --no-deps --no-build-isolation . \
    && useradd --create-home --home-dir /home/receita --shell /bin/bash receita \
    && mkdir -p /app/runs /app/experiments/profile /tmp/.X11-unix \
    && chown -R receita:receita /app /home/receita \
    && chmod 1777 /tmp/.X11-unix

COPY docker/ingest/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
USER receita
ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-m", "experiments.receita_environment_probe.pure_cdp", "--device", "desktop", "--output", "runs/probe"]
